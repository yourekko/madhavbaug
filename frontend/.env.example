# Public site URL — no trailing slash. Used for canonical links, Open Graph, JSON-LD.
# Set the same value in Vercel Environment Variables for production builds.
VITE_SITE_URL=https://www.madhavbaug.com

# Vite asset base. Use `/forum/` when the app is hosted at https://yourdomain.com/forum/ (Hostinger subfolder).
# Omit or use `/` for root hosting (e.g. localhost, apex domain).
# VITE_BASE_PATH=/forum/

# API origin (no trailing slash).
# VITE_API_BASE_URL=https://your-api.onrender.com

# Same OAuth 2.0 Web client ID as in Google Cloud Console (Authorized JavaScript origins must include this app origin).
VITE_GOOGLE_CLIENT_ID=
