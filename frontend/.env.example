# Public site URL — no trailing slash. Used for canonical links, Open Graph, JSON-LD.
# Set the same value in Vercel Environment Variables for production builds.
VITE_SITE_URL=https://www.madhavbaug.com

# Vite asset base. Committed `.env.production` sets `/forum/` for Hostinger (`public_html/forum/`).
# For root-only hosting, remove `VITE_BASE_PATH` from `.env.production` and replace `public/.htaccess`
# with the root SPA snippet (see git history) so `/assets/*` is served from `public_html/`.
# VITE_BASE_PATH=/forum/

# API origin (no trailing slash). Used for production builds (`npm run build:forum`).
# VITE_API_BASE_URL=https://your-api.onrender.com
#
# Local API URL belongs in `.env.development` only — do not put it in `.env.local`
# or production zips will call localhost and show "Failed to fetch".
#
# For Hostinger / `npm run build:forum`, see committed `.env.production` (used by `vite build` only).

# Same OAuth 2.0 Web client ID as in Google Cloud Console (Authorized JavaScript origins must include this app origin).
VITE_GOOGLE_CLIENT_ID=
